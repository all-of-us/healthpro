			message: '#^PHPDoc tag @var with type object\{id\: string, title\: string, type\: string, status\: string, assignee\: string\} is not subtype of native type object\{id\: mixed, title\: mixed, type\: mixed, status\: mixed, assignee\: mixed\}&stdClass\.$#'
